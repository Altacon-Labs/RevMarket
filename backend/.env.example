# Operating mode: local (default) or staging.
# When BACKEND_ENV=staging, APP_ORIGIN, BACKEND_DB, and BACKEND_PORT are required explicitly.
# Production hosting and Mainnet activation are not enabled by this configuration.
BACKEND_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Database path; required when BACKEND_ENV=staging (for example /var/lib/revmarket/db/revmarket.sqlite).
# Defaults in local mode to backend/data/revmarket.sqlite.
# BACKEND_DB=
# Graceful shutdown drain window in milliseconds (100-120000, default 5000).
# BACKEND_SHUTDOWN_TIMEOUT_MS=5000
# Comma-separated Stellar G-addresses authorized for super-admin network settings and reviewer management.
# This is read only by the backend; do not copy it to a VITE_* variable.
SUPER_ADMIN_WALLETS=
# Pinata public-IPFS API JWT; keep this only in the backend process environment.
PINATA_JWT=
# Optional AI drafting assistance configuration.
# Leave AI_ENABLED=false (or leave AI_ENDPOINT, AI_API_KEY, and AI_MODEL unset) to run with AI disabled;
# manual drafting and review continue to work without AI credentials.
# When AI_ENABLED=true or any AI_* variable is set, AI_ENDPOINT, AI_API_KEY, and AI_MODEL are all required.
AI_ENABLED=false
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# Trusted reverse proxy peer IPs or CIDRs (comma-separated, for example 127.0.0.1,10.0.0.0/8).
# Leave empty unless a reverse proxy you control strips or appends X-Forwarded-For on the direct socket.
# TRUSTED_PROXIES=
# Process-local fixed-window rate limits (single backend replica)
# RATE_LIMIT=120
# AUTH_RATE_LIMIT=30
# DRAFT_RATE_LIMIT=60
# AI_RATE_LIMIT=10
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_BUCKETS=1000
# Read-only Stellar Testnet market event ingestor settings (backend/ingest.mjs)
# CONTRACT_ID=CACP6QFWWZ7BBMDXB5KHC6AAQKE3HBQ4MFFZNNAIJWYK7P6GXJAMLHIN
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# START_LEDGER=
# Maximum checkpoint age in seconds before GET /api/activity/verified marks freshness stale (default 120)
# INDEXER_STALE_AFTER_SECONDS=120
# API/worker separation: never set RESOLVER_SECRET in the backend API environment.
# Configure RESOLVER_SECRET, CONTRACT_ID, and EVENT_SOURCE_URLS only in the isolated service/worker.mjs process.
