BACKEND_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Comma-separated Stellar G-addresses authorized for super-admin network settings.
# This is read only by the backend; do not copy it to a VITE_* variable.
SUPER_ADMIN_WALLETS=
# Pinata public-IPFS API JWT; keep this only in the backend process environment.
PINATA_JWT=
# Optional database location; default backend/data/revmarket.sqlite
# BACKEND_DB=
