{
  "name": "revmarket-stellar",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {"node": ">=22.12.0"},
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend", "service"],
  "scripts": {
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "backend": "node --experimental-sqlite backend/server.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "test:contracts": "cargo test --locked --lib --manifest-path contracts/Cargo.toml",
    "build:contracts": "cargo build --locked --release --target wasm32v1-none --manifest-path contracts/Cargo.toml",
    "test:testnet": "node scripts/testnet-smoke.mjs",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "resolve": "npm run resolve --workspace service",
    "demo": "node scripts/demo.mjs"
  }
}
